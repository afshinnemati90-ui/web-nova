{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f8b7258e-79b2-444e-a352-ab47e93baa03","database_name": "web-nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a5547b261d264eecadc9d8319abd41cd" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
